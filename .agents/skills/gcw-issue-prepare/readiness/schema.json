{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCW Prepare Readiness Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_version", "profile", "checks"],
  "properties": {
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "blocking"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["structural", "agent"]
          },
          "blocking": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
