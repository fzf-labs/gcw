{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fzf-labs.local/gcw/workflow_projection.schema.json",
  "title": "GCW Workflow Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_from", "projection"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "gcw.workflow_projection/v1"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_seq", "events_hash", "generated_at"],
      "properties": {
        "last_seq": { "type": "integer" },
        "events_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "platform",
        "repository",
        "branch",
        "owner",
        "phase",
        "last_completed_step",
        "next_allowed_steps",
        "refs"
      ],
      "properties": {
        "issue": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "platform": {
          "type": "string",
          "enum": ["github", "gitlab"]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["local", "github-actions", "gitlab-ci", "manual"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "phase": {
          "type": "string",
          "enum": [
            "issue-opened",
            "issue-triaged",
            "issue-clarifying",
            "ready-for-planning",
            "planned",
            "ready-for-implementation",
            "implementing",
            "ready-for-review",
            "reviewing",
            "changes-requested",
            "blocked",
            "review-complete"
          ]
        },
        "last_completed_step": {
          "type": "string",
          "enum": [
            "gcw-issue-intake",
            "gcw-issue-triage",
            "gcw-issue-clarify",
            "gcw-issue-to-spec",
            "gcw-spec-check",
            "gcw-implement",
            "gcw-implement-check",
            "gcw-pr-publish",
            "gcw-pr-review",
            "gcw-block",
            "gcw-clarify",
            "review-complete"
          ]
        },
        "next_allowed_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gcw-issue-triage",
              "gcw-issue-clarify",
              "gcw-issue-to-spec",
              "gcw-spec-check",
              "gcw-implement",
              "gcw-implement-check",
              "gcw-pr-publish",
              "gcw-pr-review",
              "gcw-block",
              "gcw-clarify"
            ]
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "progress_comment_url": {
              "type": "string",
              "minLength": 1,
              "description": "Latest hosted issue progress comment URL (<!-- gcw-progress -->)."
            },
            "review_request_url": {
              "type": "string"
            }
          }
        },
        "active_feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "from_event_id"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            },
            "from_event_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "active_blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "from_event_id"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            },
            "from_event_id": {
              "type": "string",
              "minLength": 1
            },
            "resume_phase": {
              "type": "string"
            },
            "resume_step": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
