{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fzf-labs.local/gcw/event.schema.json",
  "title": "GCW Event",
  "$defs": {
    "progress_comment_url": {
      "type": "string",
      "minLength": 1
    },
    "sha256_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gate_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_check"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "readiness_gate_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": ["structural", "agent"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "readiness_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "rubric_version", "profile"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readiness_gate_check"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issue_classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["bug", "documentation", "enhancement", "question", "duplicate", "invalid", "wontfix"]
        },
        "area": {
          "type": "string",
          "enum": ["area:workflow", "area:skills", "area:specs", "area:tests"]
        },
        "priority": {
          "type": "string",
          "enum": ["priority:p0", "priority:p1", "priority:p2", "priority:p3"]
        },
        "repro": {
          "type": "string"
        }
      }
    },
    "remote_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["github", "gitlab"]
        },
        "issue_type": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "triage_classification": {
      "allOf": [
        {
          "$ref": "#/$defs/issue_classification"
        },
        {
          "type": "object",
          "required": ["type", "priority"]
        }
      ]
    },
    "implement_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_check"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "result"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": "integer"
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seq", "event", "event_id", "at", "actor", "parent", "refs", "payload"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "gcw.event/v1"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "type": "string",
      "enum": [
        "gcw-issue-triage",
        "gcw-issue-clarify",
        "gcw-issue-to-spec",
        "gcw-spec-check",
        "gcw-implement",
        "gcw-implement-check",
        "gcw-pr-publish",
        "gcw-pr-review",
        "gcw-block",
        "gcw-clarify",
        "review-complete"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^gcw-"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["local", "github-actions", "gitlab-ci", "manual"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_last_seq"],
      "properties": {
        "expected_last_seq": {
          "type": "integer"
        },
        "parent_projection_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": {
          "oneOf": [
            {"type": "integer"},
            {"type": "string", "minLength": 1}
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "code_head_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-issue-triage" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "platform",
            "repository",
            "branch",
            "owner",
            "classification",
            "labels_applied",
            "remote_sync",
            "progress_comment_url"
          ],
          "properties": {
            "issue": {
              "oneOf": [
                {"type": "integer"},
                {"type": "string", "minLength": 1}
              ]
            },
            "platform": {
              "type": "string",
              "enum": ["github", "gitlab"]
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["local", "github-actions", "gitlab-ci", "manual"]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "classification": {
              "$ref": "#/$defs/triage_classification"
            },
            "labels_applied": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "remote_sync": {
              "$ref": "#/$defs/remote_sync"
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-issue-clarify" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "progress_comment_url", "gate"],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "gate": {
              "$ref": "#/$defs/readiness_gate"
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-issue-to-spec" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planning_commit_pushed", "progress_comment_url", "spec_refs"],
          "properties": {
            "planning_commit_pushed": {
              "type": "boolean"
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "spec_refs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_plan_sha", "findings_sha", "progress_sha"],
              "properties": {
                "task_plan_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "findings_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "progress_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-spec-check" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate", "progress_comment_url"],
          "properties": {
            "result": {
              "type": "string",
              "enum": ["passed", "clarifying", "blocked"]
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "gate": {
              "$ref": "#/$defs/gate"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-implement" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_summary"],
          "properties": {
            "work_summary": {
              "type": "string",
              "minLength": 1
            },
            "feedback_source": {
              "type": "string",
              "enum": ["pr-review", "human-review"]
            },
            "feedback_ref": {
              "type": "string"
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-implement-check" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate", "review_request", "risks", "scope", "reviewer_notes", "self_review", "spec_refs"],
          "properties": {
            "gate": {
              "$ref": "#/$defs/implement_gate"
            },
            "review_request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "summary", "issue_link"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "issue_link": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "risks": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_notes": {
              "type": "string",
              "minLength": 1
            },
            "self_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recorded"],
              "properties": {
                "recorded": {
                  "type": "boolean"
                },
                "progress_section": {
                  "type": "string"
                }
              }
            },
            "spec_refs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_plan_sha", "findings_sha", "progress_sha"],
              "properties": {
                "task_plan_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "findings_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "progress_sha": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "planning_links": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-pr-publish" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_request_url", "rendered_from_event_id", "body_hash", "effects", "progress_comment_url"],
          "properties": {
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "review_request_url": {
              "type": "string",
              "minLength": 1
            },
            "rendered_from_event_id": {
              "type": "string",
              "minLength": 1
            },
            "body_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "effects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "operation_id", "target", "body_hash", "status"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["github_pr_upsert", "gitlab_mr_upsert"]
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body_hash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "remote_updated_at": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["applied", "skipped", "failed"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-pr-review" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "progress_comment_url"],
          "properties": {
            "result": {
              "type": "string",
              "enum": ["passed", "changes-requested", "blocked"]
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "feedback_source": {
              "type": "string",
              "enum": ["pr-review", "human-review"]
            },
            "reason": {
              "type": "string"
            },
            "block_reason": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-block" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "resume_phase", "resume_step", "progress_comment_url"],
          "properties": {
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "resume_phase": {
              "type": "string",
              "enum": [
                "issue-triaged",
                "issue-clarifying",
                "ready-for-planning",
                "planned",
                "ready-for-implementation",
                "implementing",
                "ready-for-review",
                "reviewing",
                "changes-requested"
              ]
            },
            "resume_step": {
              "type": "string",
              "enum": [
                "gcw-issue-triage",
                "gcw-issue-clarify",
                "gcw-issue-to-spec",
                "gcw-spec-check",
                "gcw-implement",
                "gcw-implement-check",
                "gcw-pr-publish",
                "gcw-pr-review"
              ]
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "gcw-clarify" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "source_phase", "progress_comment_url"],
          "properties": {
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "source_phase": {
              "type": "string",
              "enum": [
                "issue-triaged",
                "issue-clarifying",
                "ready-for-planning",
                "planned",
                "ready-for-implementation",
                "implementing",
                "ready-for-review",
                "reviewing",
                "changes-requested"
              ]
            }
          }
        }
      }
    },
    {
      "required": ["event", "payload"],
      "properties": {
        "event": { "const": "review-complete" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "progress_comment_url"],
          "properties": {
            "result": {
              "type": "string",
              "enum": ["merged", "closed", "accepted", "rejected"]
            },
            "progress_comment_url": {
              "$ref": "#/$defs/progress_comment_url"
            },
            "progress_comment_body_hash": {
              "$ref": "#/$defs/sha256_hash"
            }
          }
        }
      }
    }
  ]
}
