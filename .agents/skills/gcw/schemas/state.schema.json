{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fzf-labs.local/gcw/state.schema.json",
  "title": "GCW State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "issue",
    "platform",
    "repository",
    "state",
    "branch",
    "owner",
    "last_completed_step",
    "next_allowed_steps",
    "evidence"
  ],
  "properties": {
    "issue": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["github", "gitlab"]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "issue-opened",
        "issue-clarifying",
        "ready-for-planning",
        "planned",
        "ready-for-implementation",
        "implementing",
        "ready-for-review",
        "reviewing",
        "changes-requested",
        "blocked",
        "review-complete"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["local", "github-actions", "gitlab-ci", "manual"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "last_completed_step": {
      "type": "string"
    },
    "next_allowed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "planning_files_exist",
        "planning_commit_pushed",
        "progress_comment_url",
        "spec_check_passed",
        "implement_check_passed",
        "self_review_recorded",
        "review_request_url"
      ],
      "properties": {
        "planning_files_exist": { "type": "boolean" },
        "planning_commit_pushed": { "type": "boolean" },
        "progress_comment_url": { "type": "string" },
        "spec_check_passed": { "type": "boolean" },
        "implement_check_passed": { "type": "boolean" },
        "self_review_recorded": { "type": "boolean" },
        "review_request_url": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "feedback_source": {
          "type": "string",
          "enum": ["pr-review", "human-review"]
        },
        "resume_state": { "type": "string" },
        "resume_step": { "type": "string" },
        "block_reason": { "type": "string" },
        "clarifying_question": { "type": "string" },
        "review_result": { "type": "string" }
      }
    }
  }
}
